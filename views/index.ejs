<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <title>AA展示場</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="header">
        <h1>AA展示場</h1>
        <!-- ログイン状態によって表示を切り替える部分 -->
        <div class="nav">
            <% if (user) { %>
                <span>ようこそ、<%= user.username %>さん</span>
                <a href="/logout" class="btn">ログアウト</a>
            <% } else { %>
                <a href="/login" class="btn">ログイン</a>
                <a href="/register" class="btn">新規登録</a>
            <% } %>
        </div>
    </div>

    <!-- ログインしている人だけ投稿フォームを表示 -->
    <% if (user) { %>
        <div class="post-form">
            <h2>AAを投稿する</h2>
            <form action="/post" method="POST">
                <input type="text" name="title" placeholder="作品のタイトル" required>
                <textarea name="content" rows="10" placeholder="ここにAAを貼り付け" required></textarea>
                <button type="submit" class="btn primary">投稿する</button>
            </form>
        </div>
    <% } else { %>
        <p class="login-prompt">AAを投稿したり、いいねをするには<a href="/login">ログイン</a>してください。</p>
    <% } %>

    <!-- 投稿されたAAの一覧表示 -->
    <div class="timeline">
        <% posts.forEach(post => { %>
            <div class="aa-container">
                <h2><%= post.title %></h2>
                <div class="aa-text"><%= post.content %></div>
                <p>投稿者: <%= post.author.username %></p>
            </div>
        <% }) %>
    </div>
</body>
</html>
