<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <title>AA展示場</title>
    <link rel="stylesheet" href="/style.css">
    <style>
        #aa-preview { min-height: 100px; border: 2px dashed #ddd; background-color: #fff; margin-bottom: 20px; }
        .preview-label { font-size: 13px; color: #666; margin-top: 10px; display: block; }
        .controls { background: #f8f9fa; padding: 10px; border-radius: 4px; margin-bottom: 10px; display: flex; align-items: center; gap: 10px; font-size: 14px; }
        input[type="range"] { cursor: pointer; width: 150px; }
        .aa-container { position: relative; }
        /* 投稿ごとのサイズ調整バー */
        .post-size-control { margin-bottom: 10px; border-top: 1px solid #eee; padding-top: 10px; }
    </style>
</head>
<body>
    <div class="header">
        <h1>AA展示場</h1>
        <div class="nav">
            <% if (user) { %>
                <span>ようこそ、<%= user.username %>さん</span>
                <a href="/logout" class="btn">ログアウト</a>
            <% } else { %>
                <a href="/login" class="btn">ログイン</a>
                <a href="/register" class="btn">新規登録</a>
            <% } %>
        </div>
    </div>

    <% if (user) { %>
        <div class="post-form">
            <h2>AAを投稿する</h2>
            <form action="/post" method="POST">
                <input type="text" name="title" placeholder="作品のタイトル" required>
                <textarea id="aa-input" name="content" rows="10" placeholder="ここにAAを貼り付け" required></textarea>
                
                <label class="preview-label">▼ 投稿前プレビュー</label>
                <div class="controls">
                    <span>サイズ:</span>
                    <input type="range" class="size-slider" data-target="aa-preview" min="1" max="30" value="16">
                </div>
                <pre id="aa-preview" class="aa-text" style="font-size: 16px;"></pre>
                
                <button type="submit" class="btn primary">投稿する</button>
            </form>
        </div>
    <% } %>

    <div class="timeline">
        <% posts.forEach((post, index) => { %>
            <div class="aa-container">
                <div class="post-header">
                    <h2><%= post.title %></h2>
                    <span class="author">投稿者: <%= post.author.username %></span>
                </div>
                
                <!-- 閲覧者用サイズ調整バー -->
                <div class="controls post-size-control">
                    <span>表示サイズ:</span>
                    <input type="range" class="size-slider" data-target="post-text-<%= index %>" min="1" max="30" value="16">
                </div>

                <pre id="post-text-<%= index %>" class="aa-text"><%= post.content %></pre>
                
                <div class="post-footer" style="display: flex; align-items: center; gap: 15px; margin-top: 10px;">
                    <span class="date"><%= post.createdAt.toLocaleDateString() %></span>
                    <form action="/like/<%= post.id %>" method="POST" style="display:inline;">
                        <button type="submit" class="like-btn">
                            <% const isLiked = user && post.likes.some(l => l.userId === user.id); %>
                            <%= isLiked ? '❤️ 解除' : '👍 いいね！' %> (<%= post._count.likes %>)
                        </button>
                    </form>
                </div>
            </div>
        <% }) %>
    </div>

    <script>
        // プレビューのリアルタイム反映
        const input = document.getElementById('aa-input');
        const preview = document.getElementById('aa-preview');
        if (input && preview) {
            input.addEventListener('input', () => { preview.textContent = input.value; });
        }

        // 全てのスライダーに共通の動きを設定
        document.querySelectorAll('.size-slider').forEach(slider => {
            slider.addEventListener('input', (e) => {
                const targetId = e.target.getAttribute('data-target');
                const targetElement = document.getElementById(targetId);
                if (targetElement) {
                    targetElement.style.fontSize = e.target.value + 'px';
                }
            });
        });
    </script>
</body>
</html>
