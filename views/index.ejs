<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <title>AA展示場</title>
    <link rel="stylesheet" href="/style.css">
    <style>
        /* プレビューとスライダー用のスタイル追加 */
        #aa-preview {
            min-height: 100px;
            border: 2px dashed #ddd;
            background-color: #fff;
            margin-top: 10px;
            margin-bottom: 20px;
        }
        .preview-label {
            font-size: 13px;
            color: #666;
            margin-top: 10px;
            display: block;
        }
        .controls {
            background: #f8f9fa;
            padding: 10px;
            border-radius: 4px;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 15px;
        }
        input[type="range"] {
            cursor: pointer;
            width: 200px;
        }
        .font-size-display {
            font-weight: bold;
            color: #1a73e8;
            min-width: 50px;
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>AA展示場</h1>
        <div class="nav">
            <% if (user) { %>
                <span>ようこそ、<%= user.username %>さん</span>
                <a href="/logout" class="btn">ログアウト</a>
            <% } else { %>
                <a href="/login" class="btn">ログイン</a>
                <a href="/register" class="btn">新規登録</a>
            <% } %>
        </div>
    </div>

    <% if (user) { %>
        <div class="post-form">
            <h2>AAを投稿する</h2>
            <form action="/post" method="POST">
                <input type="text" name="title" placeholder="作品のタイトル" required>
                
                <label class="preview-label">内容入力：</label>
                <textarea id="aa-input" name="content" rows="10" placeholder="ここにAAを貼り付け" required></textarea>
                
                <label class="preview-label">▼ リアルタイムプレビュー (フォントサイズを調整して確認！)</label>
                
                <!-- フォントサイズ調整スライダー -->
                <div class="controls">
                    <span>文字サイズ:</span>
                    <input type="range" id="font-slider" min="1" max="30" value="16">
                    <span class="font-size-display"><span id="size-num">16</span>px</span>
                </div>

                <pre id="aa-preview" class="aa-text" style="font-size: 16px;"></pre>
                
                <button type="submit" class="btn primary">投稿する</button>
            </form>
        </div>
    <% } else { %>
        <p class="login-prompt">AAを投稿したり、いいねをするには<a href="/login">ログイン</a>してください。</p>
    <% } %>

    <div class="timeline">
        <% posts.forEach(post => { %>
            <div class="aa-container">
                <div class="post-header">
                    <h2><%= post.title %></h2>
                    <span class="author">投稿者: <%= post.author.username %></span>
                </div>
                
                <!-- 一覧側のAAも、CSSで指定したデフォルトサイズで表示 -->
                <pre class="aa-text"><%= post.content %></pre>
                
                <div class="post-footer" style="display: flex; align-items: center; gap: 15px; margin-top: 10px;">
                    <span class="date"><%= post.createdAt.toLocaleDateString() %></span>
                    
                    <form action="/like/<%= post.id %>" method="POST" style="display:inline;">
                        <button type="submit" class="like-btn">
                            <% const isLiked = user && post.likes.some(l => l.userId === user.id); %>
                            <%= isLiked ? '❤️ いいね解除' : '👍 いいね！' %> 
                            (<%= post._count.likes %>)
                        </button>
                    </form>
                </div>
            </div>
        <% }) %>
    </div>

    <script>
        const input = document.getElementById('aa-input');
        const preview = document.getElementById('aa-preview');
        const slider = document.getElementById('font-slider');
        const sizeNum = document.getElementById('size-num');

        // 入力時にプレビューを更新
        if (input && preview) {
            input.addEventListener('input', () => {
                preview.textContent = input.value;
            });
        }

        // スライダー操作時にフォントサイズを変更
        if (slider && preview) {
            slider.addEventListener('input', (e) => {
                const size = e.target.value;
                preview.style.fontSize = size + 'px';
                sizeNum.textContent = size;
            });
        }
    </script>
</body>
</html>
