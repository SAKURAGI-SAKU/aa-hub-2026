<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <title>新規登録</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1>アカウント作成</h1>
    <form action="/register" method="POST">
        <input type="text" name="username" placeholder="好きなユーザー名" required>
        <input type="password" name="password" placeholder="パスワード" required>
        <button type="submit">登録する</button>
    </form>
    <a href="/">トップに戻る</a>
</body>
</html>
